        <mxCell id="agg" value="ins-product-aggregator&lt;br/&gt;[сервис]&lt;br/&gt;продукты/тарифы (как было)&lt;br/&gt;+ Outbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0E5BA6;fontSize=11;" vertex="1" parent="1">
