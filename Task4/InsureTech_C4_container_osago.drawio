        </mxCell>
        <mxCell id="settle" value="ins-comp-settlement&lt;br/&gt;[сервис]&lt;br/&gt;взаиморасчёты&lt;br/&gt;+ Outbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0E5BA6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="620" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="osago" value="osago-aggregator&amp;nbsp; [НОВЫЙ сервис]&lt;br/&gt;отправка заявок в СК + опрос&lt;br/&gt;предложений (≤60с), передача в core-app&lt;br/&gt;паттерны устойчивости, изоляция по СК" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B6E4F;fontColor=#ffffff;strokeColor=#08583E;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="820" width="290" height="150" as="geometry" />
        </mxCell>
