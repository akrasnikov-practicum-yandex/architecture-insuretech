          <mxGeometry x="740" y="515" width="370" height="55" as="geometry" />
        </mxCell>
        <mxCell id="t_offers" value="topic: osago-offers&amp;nbsp; (partition by requestId)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B39DDB;fontColor=#1A0E33;strokeColor=#52399A;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="595" width="370" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pg" value="PostgreSQL&lt;br/&gt;[схемы по сервисам]&lt;br/&gt;+ таблицы outbox" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0E5BA6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="720" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ins" value="Страховые компании ×10&lt;br/&gt;[внешние системы, REST API]&lt;br/&gt;продукты/тарифы +&lt;br/&gt;ОСАГО: 1) создать заявку,&lt;br/&gt;2) получить предложение" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#6E6E6E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1690" y="560" width="200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="bhdr" value="Паттерны отказоустойчивости: osago-aggregator → страховые компании" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=11;fontColor=#8A1F1B;" vertex="1" parent="1">
          <mxGeometry x="700" y="985" width="760" height="20" as="geometry" />
        </mxCell>
        <mxCell id="b_to" value="Timeout 60с" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#8A1F1B;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="1015" width="130" height="45" as="geometry" />
        </mxCell>
        <mxCell id="b_retry" value="Retry&lt;br/&gt;backoff+jitter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#8A1F1B;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="845" y="1015" width="140" height="45" as="geometry" />
        </mxCell>
        <mxCell id="b_cb" value="Circuit Breaker&lt;br/&gt;на каждую СК" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#8A1F1B;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="1015" width="150" height="45" as="geometry" />
        </mxCell>
        <mxCell id="b_rl" value="Rate Limiting&lt;br/&gt;на каждую СК" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#8A1F1B;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1165" y="1015" width="150" height="45" as="geometry" />
        </mxCell>
        <mxCell id="b_bulk" value="Bulkhead&lt;br/&gt;пул на каждую СК" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#8A1F1B;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1330" y="1015" width="160" height="45" as="geometry" />
        </mxCell>
        <mxCell id="n_osago" value="&lt;b&gt;osago-aggregator (решения):&lt;/b&gt;&lt;br/&gt;• своё хранилище — ДА (Redis): in-flight state, offers, идемпотентность.&lt;br/&gt;• API для core-app: REST &lt;b&gt;POST /osago-requests&lt;/b&gt; → 202 {aggregationId}; результаты — асинхронно событиями.&lt;br/&gt;• core-app ↔ osago-aggregator: инициация REST (sync ack), поток предложений — Kafka &lt;b&gt;osago-offers&lt;/b&gt;." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1180" y="200" width="420" height="170" as="geometry" />
        </mxCell>
        <mxCell id="n_instances" value="&lt;b&gt;Сервисы в нескольких экземплярах — учтено:&lt;/b&gt;&lt;br/&gt;• SSE: предложение → экземпляр core-app с соединением пользователя ⇒ sticky sessions (L7) и/или все экземпляры читают osago-offers и фильтруют по requestId.&lt;br/&gt;• osago-aggregator: общий стейт (Redis), &lt;b&gt;распределённые&lt;/b&gt; Circuit Breaker и Rate Limiter, идемпотентный опрос." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1180" y="820" width="420" height="180" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Легенда&lt;/b&gt;&lt;br/&gt;— сплошная: REST (синхронно)&lt;br/&gt;— пунктир фиолетовый: событие Kafka (async)&lt;br/&gt;— пунктир оранжевый: SSE (server→client)&lt;br/&gt;— зелёная: доступ к БД&lt;br/&gt;Бейджи паттернов можно заменить на офиц. библиотеку обозначений draw.io." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1120" width="470" height="110" as="geometry" />
        </mxCell>
