        <mxCell id="title" value="InsureTech — C4 Container Diagram (to-be, Event-Driven)" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
