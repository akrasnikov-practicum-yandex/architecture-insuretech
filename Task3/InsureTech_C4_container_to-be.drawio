          <mxGeometry x="40" y="160" width="1190" height="800" as="geometry" />
        </mxCell>
        <mxCell id="b2c" value="Клиент B2C&lt;br/&gt;[Person]&lt;br/&gt;подбор и оформление страховок" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#073B6F;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="55" width="190" height="80" as="geometry" />
