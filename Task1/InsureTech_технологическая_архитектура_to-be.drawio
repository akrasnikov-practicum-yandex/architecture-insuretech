  <diagram id="insuretech-to-be" name="InsureTech_тех_архитектура_to-be">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="InsureTech — технологическая архитектура (to-be)&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;Active-Active, 3 зоны доступности&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;SLA 99,9% · RTO 45м · RPO 15м" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b2c" value="B2C: веб-клиенты&lt;br/&gt;(регионы РФ, все часовые пояса)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b2b" value="B2B-партнёры&lt;br/&gt;(API-интеграции)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="1320" y="90" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cdn" value="Yandex CDN&lt;br/&gt;(статика, edge-кэш)&lt;br/&gt;= одинаковое время загрузки" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="300" y="85" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gslb" value="GSLB / Yandex Cloud DNS&lt;br/&gt;гео-роутинг + health-based failover" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="620" y="85" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_failover" value="&lt;b&gt;Фейловер (клиент↔приложение):&lt;/b&gt;&lt;br/&gt;Active-Active — все 3 зоны обслуживают трафик. GSLB опрашивает health-check каждые ~10с; при отказе зоны — DNS-failover на здоровые зоны. Низкий TTL ⇒ переключение ≪ RTO 45м. Резерв мощности по правилу 50% утилизации." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="60" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n_scaling" value="&lt;b&gt;Масштабирование:&lt;/b&gt;&lt;br/&gt;Горизонтальное — для stateless-сервисов (K8s HPA + доп. ноды/зоны); именно оно эффективно при росте RPS. Вертикальное — дополняюще для БД. Доп. зоны обязательны для 99,9% и гео-латентности." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1370" y="200" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n_clusters" value="&lt;b&gt;K8s:&lt;/b&gt; независимые кластеры в каждой зоне (НЕ stretched). Сетевой раздел между зонами не ломает кворум control-plane/etcd; отказ зоны локализуется. Stretched требует low-latency сети и хрупок к partition." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="215" width="470" height="90" as="geometry" />
        </mxCell>
