        <mxCell id="s3" value="Yandex Object Storage (S3)&lt;br/&gt;бэкапы + WAL-архив" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="620" y="1130" width="280" height="95" as="geometry" />
        </mxCell>
        <mxCell id="mon" value="Prometheus + Grafana + Alertmanager&lt;br/&gt;(проактивный мониторинг доступности, алерты)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="1050" y="1140" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_db" value="&lt;b&gt;БД: PostgreSQL + Patroni&lt;/b&gt; (фреймворк HA-кластера).&lt;br/&gt;1 Primary + 2 реплики по зонам, etcd-кворум (3 узла), HAProxy.&lt;br/&gt;Авто-failover ~30с ≪ RTO 45м. Синхронная реплика ⇒ RPO≈0 при отказе зоны; pgBackRest архивирует WAL в S3 (≤5м) ⇒ RPO ≤ 15м даже при потере кластера." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1090" width="540" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n_shard" value="&lt;b&gt;Шардирование: НЕ применяем.&lt;/b&gt;&lt;br/&gt;50 GB ≪ порога целесообразности; решение необратимо. Масштабирование чтения — реплики. Пересмотр при росте данных (~150+ GB)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1430" y="1090" width="250" height="130" as="geometry" />
        </mxCell>
